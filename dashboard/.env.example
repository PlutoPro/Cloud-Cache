# Public URL of this dashboard (register APP_URL/auth/callback as a redirect URI at your provider)
APP_URL=http://localhost:3100
# 32+ random characters; encrypts the session cookie. e.g. `openssl rand -base64 32`
SESSION_SECRET=

# --- OpenID Connect provider -----------------------------------------------------------------
# Any OIDC provider works for sign-in. The dashboard needs a confidential client with the
# authorization-code grant (users) and client-credentials grant (reading usage).
# Issuer exactly as it appears in tokens (Auth0's ends with "/").
OIDC_ISSUER=http://localhost:18081/realms/kv
# Optional: how this server reaches the provider, if different from the public URL (Docker).
OIDC_INTERNAL_URL=
OIDC_CLIENT_ID=kv-dashboard
OIDC_CLIENT_SECRET=change-me-kv-dashboard
# Keycloak with Organizations: "openid organization:*". Auth0: "openid profile email".
OIDC_SCOPES=openid organization:*
# Auth0 only: your Cloud Cache API identifier, so access tokens are issued for it.
OIDC_AUDIENCE=

# --- Member management (optional) ------------------------------------------------------------
# keycloak = manage org members from the dashboard (Keycloak admin API).
# none     = hide the Members page; manage members in your provider's own console.
MEMBERS_PROVIDER=keycloak
# Keycloak group whose subgroups mark org admins (/org-admins/<alias>). Must match Cloud Cache.
KEYCLOAK_ADMIN_GROUP=org-admins

# --- Cloud Cache -----------------------------------------------------------------------------
# Through the load balancer (reads/writes of single keys)
CLOUD_CACHE_URL=http://localhost:18080
# Every node, comma-separated, for listing keys and summing usage (data is per node)
CLOUD_CACHE_NODES=http://localhost:18080
# Endpoints shown on the Connect page
PUBLIC_HTTP_ENDPOINT=http://localhost:18080
PUBLIC_TCP_ENDPOINT=localhost:17379
